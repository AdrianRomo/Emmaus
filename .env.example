SECRET_KEY=change-me-in-production
# Development example. Production: DEBUG=false (the default when unset) and a long random SECRET_KEY.
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
TIME_ZONE=America/Mexico_City

DATABASE_URL=postgres://emmaus:emmaus@db:5432/emmaus
# Reuse database connections for N seconds (keep low on free-tier Postgres).
DB_CONN_MAX_AGE=60
POSTGRES_PASSWORD=change-me

# Shared interview computers: close idle staff sessions after N seconds.
EMMAUS_IDLE_LOGOUT_SECONDS=1800
# Behind HTTPS in production:
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Emmaus <no-reply@example.org>

# Optional AI drafts for the discipleship module only. The camp module never uses AI.
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Development only: password for `manage.py seed_camp_demo` / `seed_dev_data`.
EMMAUS_DEMO_PASSWORD=
