# Copy to .env. The values below are for DEVELOPMENT.
# Every variable appears exactly once, and comments sit on their own lines: a comment after a
# value would become part of the value (SECURE_HSTS_SECONDS must be a bare number).
#
# ---- Producción (production, behind Traefik or another HTTPS proxy) -------------------------
# Do not add a second line for a variable: change the value on its existing line.
#   SECRET_KEY            a long random string
#   DEBUG                 false
#   ALLOWED_HOSTS         the real hostname, first: campamento.tu-iglesia.mx
#   CSRF_TRUSTED_ORIGINS  the same hostname with https://: https://campamento.tu-iglesia.mx
#   POSTGRES_PASSWORD     a strong password
#   SECURE_SSL_REDIRECT   true
#   SECURE_HSTS_SECONDS   3600 (one hour, no preload; raise to 31536000 once HTTPS is stable)
#   EMAIL_BACKEND         django.core.mail.backends.smtp.EmailBackend, plus EMAIL_HOST,
#                         EMAIL_HOST_USER, EMAIL_HOST_PASSWORD and DEFAULT_FROM_EMAIL from your
#                         SMTP provider (STARTTLS on port 587; test with manage.py sendtestemail)
#   EMMAUS_DEMO_PASSWORD  leave empty
# SESSION_COOKIE_SECURE and CSRF_COOKIE_SECURE are not listed: with DEBUG=false they are true.
# That is why signing in over plain http://<LAN-IP>:8000 fails (CSRF 403); use https://<hostname>.
# DATABASE_URL is set by docker-compose.prod.yml from POSTGRES_PASSWORD.
# Before a real camp on a server that showed the demo: manage.py purge_demo_data (docs/deployment.md).
# ----------------------------------------------------------------------------------------------

SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
TIME_ZONE=America/Mexico_City

DATABASE_URL=postgres://emmaus:emmaus@db:5432/emmaus
# Reuse database connections for N seconds (keep low on free-tier Postgres).
DB_CONN_MAX_AGE=60
POSTGRES_PASSWORD=change-me

# Shared interview computers: close idle staff sessions after N seconds.
EMMAUS_IDLE_LOGOUT_SECONDS=1800
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

# The console backend only prints invitations, password resets and safety alerts to the log.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Emmaus <no-reply@example.org>

# Optional AI drafts for the discipleship module only. The camp module never uses AI.
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Development only: password for `manage.py seed_camp_demo` / `seed_dev_data`.
EMMAUS_DEMO_PASSWORD=
